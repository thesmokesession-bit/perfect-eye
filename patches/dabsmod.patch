+/**
+ * Each controller's light bar shows its player: the team's colour in a team
+ * match on this console, otherwise the PS5's own player colours (blue, red,
+ * green, pink) by controller. Sent only when it changes, and again to a
+ * controller that has just taken the slot.
+ */
+static void inputPs5UpdateLightBars(void)
+{
+	static const u32 playercolours[4] = { 0x0040ffff, 0xff2020ff, 0x20e040ff, 0xff40c0ff };
+	static u32 sent[INPUT_MAX_CONTROLLERS];
+	static SDL_GameController *sentto[INPUT_MAX_CONTROLLERS];
+
+	for (s32 i = 0; i < INPUT_MAX_CONTROLLERS && i < 4; i++) {
+		u32 rgba = playercolours[i];
+
+		if (!pads[i]) {
+			sentto[i] = NULL;
+			continue;
+		}
+
+		if (g_NetMode == NETMODE_NONE && g_Vars.normmplayerisrunning
+				&& (g_MpSetup.options & MPOPTION_TEAMSENABLED)
+				&& g_Vars.players[i] && g_Vars.players[i]->prop && g_Vars.players[i]->prop->chr) {
+			rgba = g_TeamColours[radarGetTeamIndex(g_Vars.players[i]->prop->chr->team)];
+		}
+
+		if (rgba != sent[i] || pads[i] != sentto[i]) {
+			SDL_GameControllerSetLED(pads[i], (rgba >> 24) & 0xff, (rgba >> 16) & 0xff, (rgba >> 8) & 0xff);
+			sent[i] = rgba;
+			sentto[i] = pads[i];
+		}
+	}
+}
+#endif
