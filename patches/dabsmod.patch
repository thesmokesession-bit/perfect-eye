+static void inputPs5UpdateKeyboardMouse(void)
+{
+	static s32 started, kbd = -1, mouse = -1, retry;
+	static Ps5KeyboardState prev;
+	static u32 prevButtons;
+	SDL_Window *wnd = videoGetWindowHandle();
+	int user = -1;
+
+	if (!wnd) {
+		return;
