+
+static void inputPs5UpdateGyro(void)
+{
+	for (s32 i = 0; i < 4 && i < INPUT_MAX_CONTROLLERS; i++) {
+		Ps5PadState st;
+		f32 q[4];
+
+		gyroDX[i] = gyroDY[i] = 0.f;
+
+		if (!pads[i]) {
+			gyroFor[i] = NULL;
+			continue;
+		}
+
+		if (gyroFor[i] != pads[i]) {
+			gyroFor[i] = pads[i];
+			gyroHavePrev[i] = 0;
+			gyroHandle[i] = inputPs5GyroHandle(i);
+		}
+
+		if (!g_InputPs5Gyro || gyroHandle[i] < 0) {
+			continue;
+		}
+
+		memset(&st, 0, sizeof(st));
+
+		if (scePadReadState(gyroHandle[i], &st) != 0) {
+			// the handle went (rest mode, a reconnect): look it up again, once a second
+			static u32 fails[4];
+			if (++fails[i] % 60 == 1) gyroFor[i] = NULL;
+			continue;
+		}
+
+		q[0] = st.qx; q[1] = st.qy; q[2] = st.qz; q[3] = st.qw;
+
+		if (q[0] == 0.f && q[1] == 0.f && q[2] == 0.f && q[3] == 0.f) {
+			continue; // no orientation from this pad
+		}
+
+		if (gyroHavePrev[i]) {
+			// the rotation since last frame in the pad's own frame: conj(prev) * q
+			const f32 *p = gyroPrev[i];
+			f32 dw = p[3] * q[3] + p[0] * q[0] + p[1] * q[1] + p[2] * q[2];
+			f32 dx = p[3] * q[0] - p[0] * q[3] - p[1] * q[2] + p[2] * q[1];
+			f32 dy = p[3] * q[1] + p[0] * q[2] - p[1] * q[3] - p[2] * q[0];
+
+			if (dw < 0.f) {
+				dx = -dx;
+				dy = -dy;
+			}
+
+			// 2 * the vector part is the angle in radians for a small turn; a
+			// deadband keeps a pad lying still from creeping the view
+			const f32 yaw = 2.f * dy, pitch = 2.f * dx;
+			const f32 deadband = 0.0004f;
+			const f32 scale = 57.29578f / 3.5f * gyroSpeed;
+
+			if (fabsf(yaw) > deadband) gyroDX[i] = -yaw * scale;
+			if (fabsf(pitch) > deadband) gyroDY[i] = -pitch * scale;
+		}
+
+		memcpy(gyroPrev[i], q, sizeof(q));
+		gyroHavePrev[i] = 1;
+	}
+}
