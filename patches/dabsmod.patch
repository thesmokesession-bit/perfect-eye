+/**
+ * The kill cam (Mod.KillCam: -1 online only, the default, 0 off, 1 every
+ * Combat Simulator match): once the fall is over, a few seconds of whoever
+ * killed you, from a camera found round them the way the replay finds one
+ * round the body (deathcamPick()), turned to follow them. It is the killer
+ * as they are now, not a recording of the shot. Then the game's own death
+ * view, and the respawn as ever.
+ */
+#define KILLCAM_FROM 45  // 60ths after the death: the fall first
+#define KILLCAM_TO   225 // three seconds of the killer
+#define KILLCAM_EYE  55  // over a chr's position, about the chest
+
+s32 g_KillCam = -1; // Mod.KillCam
+
+struct killcam {
+	s32 stagenum;
+	s32 at;      // the death it is for (killfeedKillerOf()'s lvframe60)
+	s32 ok;      // a camera was found
+	struct coord campos;
+	RoomNum camrooms[8];
+	struct coord look; // eased toward the killer
+};
+
+static struct killcam g_KillCams[MAX_PLAYERS];
+
+PD_CONSTRUCTOR static void killcamConfigInit(void)
+{
+	configRegisterInt("Mod.KillCam", &g_KillCam, -1, 1);
+}
+
+s32 geKillCamCamera(struct coord *pos, struct coord *up, struct coord *look,
+		struct coord *hintpos, RoomNum *hintrooms)
+{
+	struct player *pl = g_Vars.currentplayer;
+	struct killcam *kc = &g_KillCams[g_Vars.currentplayernum];
+	struct chrdata *killer;
+	struct coord target;
+	s32 victim, a, at, age;
+	f32 len;
+
+	if (!(g_KillCam == 1 || (g_KillCam < 0 && g_NetMode != NETMODE_NONE))
+			|| !g_Vars.normmplayerisrunning || !pl || !pl->prop || !pl->prop->chr || !pl->isdead) {
+		return 0;
+	}
+
+	victim = mpPlayerGetIndex(pl->prop->chr);
+	a = killfeedKillerOf(victim, &at);
+	age = g_Vars.lvframe60 - at;
+
+	if (a < 0 || a >= MAX_MPCHRS || age < KILLCAM_FROM || age >= KILLCAM_TO
+			|| !(killer = g_MpAllChrPtrs[a]) || !killer->prop || killer->prop->rooms[0] < 0) {
+		return 0;
+	}
+
+	target = killer->prop->pos;
+	target.y += KILLCAM_EYE;
+
+	if (kc->stagenum != g_Vars.stagenum || kc->at != at) {
+		struct deathcam dc;
+		struct coord from = target;
+		RoomNum fromrooms[8];
+
+		memset(&dc, 0, sizeof(dc));
+		memcpy(fromrooms, killer->prop->rooms, sizeof(fromrooms));
+		fromrooms[7] = -1;
+
+		kc->stagenum = g_Vars.stagenum;
+		kc->at = at;
+		kc->ok = deathcamPick(&dc, &target, &from, fromrooms, DEATHCAM_DIST);
+		kc->campos = dc.campos;
+		memcpy(kc->camrooms, dc.camrooms, sizeof(kc->camrooms));
+		kc->look = target;
+
+		sysLogPrintf(LOG_NOTE, "killcam: player %d killed by %d, %s", victim, a,
+				kc->ok ? "watching them" : "nowhere to watch from");
+	}
+
+	if (!kc->ok) {
+		return 0;
+	}
+
+	// the look eased after them, a fifth of the way a tick
+	kc->look.x += (target.x - kc->look.x) * 0.2f;
+	kc->look.y += (target.y - kc->look.y) * 0.2f;
+	kc->look.z += (target.z - kc->look.z) * 0.2f;
+
+	look->x = kc->look.x - kc->campos.x;
+	look->y = kc->look.y - kc->campos.y;
+	look->z = kc->look.z - kc->campos.z;
+	len = sqrtf(look->x * look->x + look->y * look->y + look->z * look->z);
+
+	if (len < 1.0f) {
+		return 0;
+	}
+
+	look->x /= len;
+	look->y /= len;
+	look->z /= len;
+
+	*pos = kc->campos;
+	up->x = 0;
+	up->y = 1;
+	up->z = 0;
+	*hintpos = kc->campos;
+	memcpy(hintrooms, kc->camrooms, sizeof(kc->camrooms));
+
+	return 1;
+}
+
 #endif
