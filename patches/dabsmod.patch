+	if (!g_InputPs5Triggers || !pl || !pl->prop || pl->isdead || pl->pausemode || pl->activemenumode != AMMODE_CLOSED) {
+		return;
+	}
+
+	hand = &pl->hands[HAND_RIGHT];
+	func = gsetGetWeaponFunction2(&hand->gset);
+	type = func ? func->type : INVENTORYFUNCTYPE_NONE;
+
+	if ((type & 0xff) == INVENTORYFUNCTYPE_THROW) {
+		*r2 = (Ps5Trig){ 1, 3, 2, 0 }; // feedback: a light hold
+		return;
+	}
+
+	if ((type & 0xff) != INVENTORYFUNCTYPE_SHOOT) {
+		return;
+	}
+
+	*l2 = (Ps5Trig){ 1, 2, 2, 0 };
+
+	switch (weaponHost(hand->gset.weaponnum)) {
+	case WEAPON_SHOTGUN:
+		*r2 = (Ps5Trig){ 2, 3, 6, 8 }; // weapon: start, end, strength
+		return;
+	case WEAPON_SNIPERRIFLE:
+	case WEAPON_FARSIGHT:
+		*r2 = (Ps5Trig){ 2, 6, 8, 6 };
+		return;
+	}
+
+	if (type == INVENTORYFUNCTYPE_SHOOT_AUTOMATIC) {
+		*r2 = hand->firing ? (Ps5Trig){ 3, 3, 4, 20 } // vibration: position, amplitude, Hz
+			: (Ps5Trig){ 1, 3, 2, 0 };
+	} else if (type == INVENTORYFUNCTYPE_SHOOT_PROJECTILE) {
+		*r2 = (Ps5Trig){ 2, 5, 8, 8 };
+	} else {
+		*r2 = (Ps5Trig){ 2, 4, 6, 5 };
+	}
