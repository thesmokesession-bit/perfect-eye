+
+#if defined(PLATFORM_PS5) || defined(PD_PS5_AUDIO_TEST)
+/*
+ * 5.1 on the PS5. SDL's PS5 driver only opens one or two channels, so six go
+ * straight to a main port of eight (L R C LFE Ls Rs, the back pair silent) and
+ * the system mixes them for whatever is plugged in: a receiver gets 5.1, the
+ * console's own 3D audio or a stereo set gets its downmix. SDL resamples
+ * 22020 to the port's 48000; a thread hands the port 256 frames at a time
+ * (sceAudioOutOutput blocks until the last went out, which paces it).
+ */
+#define PS5OUT_FRAMES 256
+#define PS5OUT_FORMAT_S16_8CH 2
+
+#ifdef PD_PS5_AUDIO_TEST
+// the Linux build's stand-in for the port: real time, written to a file
+static FILE *ps5TestOut;
+static s32 sceAudioOutOpen(s32 user, s32 type, s32 index, u32 len, u32 freq, u32 param)
+{
+	ps5TestOut = fopen(getenv("PD_PS5_AUDIO_TEST_FILE") ? getenv("PD_PS5_AUDIO_TEST_FILE") : "ps5audio.raw", "wb");
+	return ps5TestOut ? 1 : -1;
+}
+static s32 sceAudioOutOutput(s32 handle, const void *p)
+{
+	if (p) fwrite(p, 2 * 8, PS5OUT_FRAMES, ps5TestOut);
+	SDL_Delay(PS5OUT_FRAMES * 1000 / 48000);
+	return 0;
+}
+static s32 sceAudioOutClose(s32 handle) { fclose(ps5TestOut); return 0; }
+#else
+s32 sceAudioOutOpen(s32 userId, s32 type, s32 index, u32 len, u32 freq, u32 param);
+s32 sceAudioOutOutput(s32 handle, const void *p);
+s32 sceAudioOutClose(s32 handle);
+#endif
+
+static s32 ps5Out = 0; // the port, 0 when 5.1 is not going out this way
+static SDL_AudioStream *ps5Stream;
+static SDL_mutex *ps5Lock;
+static SDL_Thread *ps5Thread;
+static SDL_atomic_t ps5Run;
+
+static int ps5OutThread(void *arg)
+{
+	static s16 six[PS5OUT_FRAMES * 6];
+	static s16 eight[PS5OUT_FRAMES * 8];
+
+	while (SDL_AtomicGet(&ps5Run)) {
+		s32 got;
+
+		SDL_LockMutex(ps5Lock);
+		got = SDL_AudioStreamAvailable(ps5Stream) >= (s32)sizeof(six)
+			? SDL_AudioStreamGet(ps5Stream, six, sizeof(six)) : 0;
+		SDL_UnlockMutex(ps5Lock);
+
+		if (got != sizeof(six)) {
+			memset(six, 0, sizeof(six)); // nothing queued: silence, at the same pace
+		}
+
+		for (s32 i = 0; i < PS5OUT_FRAMES; i++) {
+			memcpy(&eight[i * 8], &six[i * 6], 6 * sizeof(s16));
+			eight[i * 8 + 6] = eight[i * 8 + 7] = 0;
+		}
+
+		sceAudioOutOutput(ps5Out, eight);
+	}
+
+	return 0;
+}
+
+static void ps5OutClose(void)
+{
+	if (ps5Out <= 0) {
+		return;
+	}
+
+	SDL_AtomicSet(&ps5Run, 0);
+	SDL_WaitThread(ps5Thread, NULL);
+	sceAudioOutOutput(ps5Out, NULL); // let the last grain finish
+	sceAudioOutClose(ps5Out);
+	SDL_FreeAudioStream(ps5Stream);
+	ps5Out = 0;
+}
+
+static s32 ps5OutOpen(void)
+{
+	ps5Stream = SDL_NewAudioStream(AUDIO_S16SYS, 6, sampleRate, AUDIO_S16SYS, 6, 48000);
+	if (!ps5Stream) {
+		return -1;
+	}
+
+	ps5Out = sceAudioOutOpen(0xff, 0, 0, PS5OUT_FRAMES, 48000, PS5OUT_FORMAT_S16_8CH);
+	if (ps5Out <= 0) {
+		sysLogPrintf(LOG_WARNING, "audio: sceAudioOutOpen 8ch failed (0x%08x), 5.1 goes out as stereo", ps5Out);
+		SDL_FreeAudioStream(ps5Stream);
+		ps5Out = 0;
+		return -1;
+	}
+
+	if (!ps5Lock) {
+		ps5Lock = SDL_CreateMutex();
+	}
+	SDL_AtomicSet(&ps5Run, 1);
+	ps5Thread = SDL_CreateThread(ps5OutThread, "ps5audio", NULL);
+	sysLogPrintf(LOG_NOTE, "audio: 5.1 straight to the PS5's audio out (8 channels, 48 kHz)");
+
+	return 0;
+}
+#endif
+
+static void audioQueue(const void *buf, u32 size)
