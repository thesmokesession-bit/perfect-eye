+				if (pad >= 0 && pad < 4) {
+					forpad[pad] = g_Vars.players[p];
+				}
+			}
+		}
+	}
+
+	for (s32 i = 0; i < 4 && i < INPUT_MAX_CONTROLLERS; i++) {
+		Ps5Trig want[2];
+		Ps5TriggerEffect fx;
+
+		if (!pads[i] || gyroHandle[i] < 0) {
+			sentto[i] = -1;
+			continue;
+		}
+
+		inputPs5TriggersFor(forpad[i], &want[0], &want[1]);
+
+		if (sentto[i] == gyroHandle[i] && !memcmp(want, sent[i], sizeof(want))) {
+			continue;
+		}
+
+		memset(&fx, 0, sizeof(fx));
