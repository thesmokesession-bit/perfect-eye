+		const int km = ps5LoadSystemModule("libSceKeyboard.sprx");
+		ps5KeyboardInit = (int (*)(void))ps5SystemSym(km, "sceKeyboardInit");
+		ps5KeyboardOpen = (int (*)(int, int, int, void *))ps5SystemSym(km, "sceKeyboardOpen");
+		ps5KeyboardReadState = (int (*)(int, Ps5KeyboardState *))ps5SystemSym(km, "sceKeyboardReadState");
+		if (!ps5KeyboardInit || !ps5KeyboardOpen) {
+			ps5KeyboardReadState = NULL;
+		}
+		if (ps5KeyboardReadState) {
+			ps5KeyboardInit(); // SDL's driver may have already: an error then is fine
+		}
+
+		const int mm = ps5LoadSystemModule("libSceMouse.sprx");
+		ps5MouseInit = (int (*)(void))ps5SystemSym(mm, "sceMouseInit");
+		ps5MouseOpen = (int (*)(int, int, int, void *))ps5SystemSym(mm, "sceMouseOpen");
+		ps5MouseRead = (int (*)(int, Ps5MouseData *, int))ps5SystemSym(mm, "sceMouseRead");
+		if (!ps5MouseInit || !ps5MouseOpen) {
+			ps5MouseRead = NULL;
+		}
+		if (ps5MouseRead) {
+			ps5MouseInit();
+		}
+		sysLogPrintf(LOG_NOTE, "input: keyboard %s, mouse %s", ps5KeyboardReadState ? "ready" : "not there",
+				ps5MouseRead ? "ready" : "not there");
+	}
+
+	// a keyboard or mouse plugged in later, or one the first try missed: once a second
+	if (((ps5KeyboardReadState && kbd < 0) || (ps5MouseRead && mouse < 0)) && retry-- <= 0) {
+		retry = 60;
+		if (sceUserServiceGetForegroundUser(&user) == 0) {
+			if (ps5KeyboardReadState && kbd < 0 && (kbd = ps5KeyboardOpen(user, 0, 0, NULL)) >= 0) {
+				sysLogPrintf(LOG_NOTE, "input: keyboard open (%d)", kbd);
+			}
+			if (ps5MouseRead && mouse < 0 && (mouse = ps5MouseOpen(user, 0, 0, NULL)) >= 0) {
+				sysLogPrintf(LOG_NOTE, "input: mouse open (%d)", mouse);
+			}
+		}
+	}
+
+	if (kbd >= 0) {
+		Ps5KeyboardState cur;
+
+		memset(&cur, 0, sizeof(cur));
+
+		if (ps5KeyboardReadState(kbd, &cur) == 0 && cur.available) {
+			static const SDL_Scancode mods[8] = {
+				SDL_SCANCODE_LCTRL, SDL_SCANCODE_LSHIFT, SDL_SCANCODE_LALT, SDL_SCANCODE_LGUI,
+				SDL_SCANCODE_RCTRL, SDL_SCANCODE_RSHIFT, SDL_SCANCODE_RALT, SDL_SCANCODE_RGUI,
+			};
+
+			for (s32 b = 0; b < 8; b++) {
+				if ((cur.modifiers ^ prev.modifiers) & (1u << b)) {
+					SDL_SendKeyboardKey((cur.modifiers & (1u << b)) ? SDL_PRESSED : SDL_RELEASED, mods[b]);
+				}
+			}
+
+			// the keys held are a set, in whatever slots: released what left it, pressed what joined
+			for (s32 i = 0; i < 16; i++) {
+				s32 still = 0, was = 0;
+
+				for (s32 j = 0; j < 16; j++) {
+					still |= prev.scankey[i] && cur.scankey[j] == prev.scankey[i];
+					was |= cur.scankey[i] && prev.scankey[j] == cur.scankey[i];
+				}
+
+				if (prev.scankey[i] && !still && prev.scankey[i] < SDL_NUM_SCANCODES) {
+					SDL_SendKeyboardKey(SDL_RELEASED, (SDL_Scancode)prev.scankey[i]);
+				}
+				if (cur.scankey[i] && !was && cur.scankey[i] < SDL_NUM_SCANCODES) {
+					SDL_SendKeyboardKey(SDL_PRESSED, (SDL_Scancode)cur.scankey[i]);
+				}
+			}
+
+			prev = cur;
+		}
+	}
+
+	if (mouse >= 0) {
+		Ps5MouseData data[8];
+		const int n = ps5MouseRead(mouse, data, 8);
+		s32 dx = 0, dy = 0, wheel = 0;
+
+		for (s32 i = 0; i < n; i++) {
+			dx += data[i].x;
+			dy += data[i].y;
+			wheel += data[i].wheel;
+		}
+
+		if (n > 0) {
+			static const Uint8 buttons[5] = { SDL_BUTTON_LEFT, SDL_BUTTON_RIGHT, SDL_BUTTON_MIDDLE, SDL_BUTTON_X1, SDL_BUTTON_X2 };
+			const u32 now = data[n - 1].buttons;
+
+			if (dx || dy) {
+				SDL_SendMouseMotion(wnd, 0, 1, dx, dy);
+			}
+			if (wheel) {
+				SDL_SendMouseWheel(wnd, 0, 0.f, (float)wheel, SDL_MOUSEWHEEL_NORMAL);
+			}
+			for (s32 b = 0; b < 5; b++) {
+				if ((now ^ prevButtons) & (1u << b)) {
+					SDL_SendMouseButton(wnd, 0, (now & (1u << b)) ? SDL_PRESSED : SDL_RELEASED, buttons[b]);
+				}
+			}
+			prevButtons = now;
+		}
+	}
+}
