+/*
+ * Get Mods and Maps: a catalogue of mods that each have a direct download, one
+ * per line as "name|author|file|https url|sha256 or nothing|blurb" ("\n" in
+ * the blurb breaks it). The newest copy is asked for from Perfect Eye's
+ * ps5-dev release when the build has one (PS5_UPDATE_REPO), else the one
+ * beside the game is read. A download lands in mods/ under its file name and
+ * the mod list unpacks and imports it there like an archive or a patch
+ * dropped in by hand.
+ */
+#define MODCAT_FILE "mod-catalogue.txt"
+#define MODCAT_MAX 64
+#define MODCAT_MAXBYTES (512u * 1024u * 1024u)
+
+struct modcatentry {
+	char name[48];
+	char author[48];
+	char file[96];
+	char url[384];
+	char sha[65];
+	char blurb[192];
+};
+
+static struct modcatentry s_Cat[MODCAT_MAX];
+static s32 s_CatCount = -1; // -1 until the page has looked once
+static struct modcatentry s_CatNew[MODCAT_MAX];
+static s32 s_CatNewCount;
+static char s_CatNote[256];
+static char s_CatMsg[192];
+static char s_CatRowText[96];
+static SDL_Thread *s_CatThread;
+static SDL_atomic_t s_CatDone;
+static s32 s_CatJob; // -1 the catalogue, else the entry being downloaded
+static s32 s_CatOk;
+static volatile s32 s_CatCancel;
+static struct ghostnetbuf s_CatBuf;
+static char s_CatTmp[FS_MAXPATH + 1];
+static char s_CatDest[FS_MAXPATH + 1];
+
+static void modCatCopyField(char *dst, u32 dstsize, const char *src, u32 len)
+{
+	u32 o = 0;
+
+	for (u32 i = 0; i < len && o + 1 < dstsize; i++) {
+		if (src[i] == '\\' && i + 1 < len && src[i + 1] == 'n') {
+			dst[o++] = '\n';
+			i++;
+		} else if (src[i] != '\r') {
+			dst[o++] = src[i];
+		}
+	}
+
+	dst[o] = '\0';
+}
+
+// The catalogue's text into out; returns how many entries it holds
+static s32 modCatParse(const char *text, struct modcatentry *out)
+{
+	s32 count = 0;
+
+	while (text && *text && count < MODCAT_MAX) {
+		const char *end = strchr(text, '\n');
+		const char *f[7];
+		u32 len = end ? (u32)(end - text) : (u32)strlen(text);
+		s32 n = 1;
+		struct modcatentry *e = &out[count];
+
+		f[0] = text;
+
+		for (u32 i = 0; i < len && n < 6; i++) {
+			if (text[i] == '|') {
+				f[n++] = text + i + 1;
+			}
+		}
+
+		f[n] = text + len + 1;
+
+		if (n == 6 && text[0] != '#') {
+			modCatCopyField(e->name, sizeof(e->name), f[0], f[1] - f[0] - 1);
+			modCatCopyField(e->author, sizeof(e->author), f[1], f[2] - f[1] - 1);
+			modCatCopyField(e->file, sizeof(e->file), f[2], f[3] - f[2] - 1);
+			modCatCopyField(e->url, sizeof(e->url), f[3], f[4] - f[3] - 1);
+			modCatCopyField(e->sha, sizeof(e->sha), f[4], f[5] - f[4] - 1);
+			modCatCopyField(e->blurb, sizeof(e->blurb), f[5], f[6] - f[5] - 1);
+
+			// a name for a file in mods/ and nothing else, over https
+			if (e->name[0] && e->file[0] && e->file[0] != '.' && !strpbrk(e->file, "/\\:")
+					&& !strncmp(e->url, "https://", 8) && (!e->sha[0] || strlen(e->sha) == 64)) {
+				count++;
+			}
+		}
+
+		text = end ? end + 1 : NULL;
+	}
+
+	return count;
+}
+
+static int modCatWorker(void *arg)
+{
+	struct ghostnetreq req;
+	s32 status = 0;
+	char sha[65];
+
+	memset(&req, 0, sizeof(req));
+	req.redirect = true;
+	req.cancel = &s_CatCancel;
+	s_CatMsg[0] = '\0';
+	s_CatOk = 0;
+
+	if (s_CatJob < 0) {
+#ifdef PS5_UPDATE_REPO
+		struct ghostnetbuf buf = { NULL, 0 };
+
+		req.url = PS5_UPDATE_REPO "/download/ps5-dev/" MODCAT_FILE;
+
+		if (ghostnetSend(&req, &buf, &status, s_CatMsg, sizeof(s_CatMsg)) && status == 200 && buf.data) {
+			s_CatNewCount = modCatParse(buf.data, s_CatNew);
+			s_CatOk = s_CatNewCount > 0;
+		}
+
+		free(buf.data);
+#endif
+	} else {
+		const struct modcatentry *e = &s_Cat[s_CatJob];
+		FILE *f = fopen(s_CatTmp, "wb");
+
+		if (!f) {
+			snprintf(s_CatMsg, sizeof(s_CatMsg), "cannot write to the mods folder");
+		} else {
+			req.url = e->url;
+			req.timeout = 3600;
+			memset(&s_CatBuf, 0, sizeof(s_CatBuf));
+			s_CatBuf.sink = f;
+			s_CatBuf.maxlen = MODCAT_MAXBYTES;
+
+			const bool sent = ghostnetSend(&req, &s_CatBuf, &status, s_CatMsg, sizeof(s_CatMsg));
+			fclose(f);
+
+			if (!sent) {
+				// s_CatMsg says why
+			} else if (s_CatCancel) {
+				snprintf(s_CatMsg, sizeof(s_CatMsg), "stopped");
+			} else if (status != 200) {
+				snprintf(s_CatMsg, sizeof(s_CatMsg), "the download answered %d", status);
+			} else if (e->sha[0] && (!sha256File(s_CatTmp, sha) || strcasecmp(sha, e->sha))) {
+				snprintf(s_CatMsg, sizeof(s_CatMsg), "the download is not the file the list describes");
+			} else if (rename(s_CatTmp, s_CatDest) != 0) {
+				snprintf(s_CatMsg, sizeof(s_CatMsg), "cannot write to the mods folder");
+			} else {
+				s_CatOk = 1;
+			}
+
+			if (!s_CatOk) {
+				remove(s_CatTmp);
+			}
+		}
+	}
+
+	SDL_AtomicSet(&s_CatDone, 1);
+
+	return 0;
+}
+
+static s32 modCatBusy(void)
+{
+	return s_CatThread != NULL;
+}
+
+static s32 modCatInstalled(s32 i)
+{
+	char path[FS_MAXPATH + 1];
+
+	snprintf(path, sizeof(path), "$E/mods/%s", s_Cat[i].file);
+
+	return fsFileSize(path) >= 0;
+}
+
+static void modCatStart(s32 job)
+{
+	s_CatJob = job;
+	s_CatCancel = 0;
+	SDL_AtomicSet(&s_CatDone, 0);
+
+	if (job >= 0) {
+		// the paths here, on the game thread: fsFullPath's buffer is not the worker's to share
+		fsCreateDir("$E/mods");
+		snprintf(s_CatDest, sizeof(s_CatDest), "%s", fsFullPath("$E/mods"));
+		snprintf(s_CatTmp, sizeof(s_CatTmp), "%s/.%s.part", s_CatDest, s_Cat[job].file);
+		snprintf(s_CatDest + strlen(s_CatDest), sizeof(s_CatDest) - strlen(s_CatDest), "/%s", s_Cat[job].file);
+	}
+
+	s_CatThread = SDL_CreateThread(modCatWorker, "modcatalogue", NULL);
+}
+
+// Once a frame while the page is up: the worker's result, when it has one
+static void modCatTick(void)
+{
+	if (!s_CatThread || !SDL_AtomicGet(&s_CatDone)) {
+		return;
+	}
+
+	SDL_WaitThread(s_CatThread, NULL);
+	s_CatThread = NULL;
+
+	if (s_CatJob < 0) {
+		if (s_CatOk) {
+			memcpy(s_Cat, s_CatNew, sizeof(s_Cat));
+			s_CatCount = s_CatNewCount;
+		}
+		s_CatNote[0] = '\0';
+	} else if (s_CatOk) {
+		sysLogPrintf(LOG_NOTE, "mods: downloaded %s to %s", s_Cat[s_CatJob].name, s_CatDest);
+		modListRefresh(); // unpacks it and imports a patch in it
+		snprintf(s_CatNote, sizeof(s_CatNote), "%s is installed.\nPlay it from Perfect Dark Mods.\n", s_Cat[s_CatJob].name);
+	} else {
+		sysLogPrintf(LOG_WARNING, "mods: %s did not download: %s", s_Cat[s_CatJob].name, s_CatMsg);
+		snprintf(s_CatNote, sizeof(s_CatNote), "%s did not download:\n%s\n", s_Cat[s_CatJob].name, s_CatMsg);
+	}
+}
+
+static MenuItemHandlerResult menuhandlerModCatList(s32 operation, struct menuitem *item, union handlerdata *data)
+{
+	const s32 i = (s32)data->list.value;
+
+	switch (operation) {
+	case MENUOP_GETOPTIONCOUNT:
+		data->list.value = s_CatCount > 0 ? s_CatCount : 0;
+		break;
+	case MENUOP_GETOPTIONTEXT:
+		snprintf(s_CatRowText, sizeof(s_CatRowText), "%s%s\n", s_Cat[i].name, modCatInstalled(i) ? " (installed)" : "");
+		return (intptr_t)s_CatRowText;
+	case MENUOP_GETSELECTEDINDEX:
+	case MENUOP_GETOPTGROUPCOUNT:
+		data->list.value = 0;
+		break;
+	case MENUOP_GETOPTGROUPTEXT:
+		return (intptr_t)"";
+	case MENUOP_GETGROUPSTARTINDEX:
+		data->list.groupstartindex = 0;
+		break;
+	case MENUOP_LISTITEMFOCUS:
+		if (!modCatBusy() && i >= 0 && i < s_CatCount) {
+			snprintf(s_CatNote, sizeof(s_CatNote), "by %s\n%s\n", s_Cat[i].author, s_Cat[i].blurb);
+		}
+		break;
+	case MENUOP_SET:
+		if (modCatBusy() || i < 0 || i >= s_CatCount) {
+			break;
+		}
+
+		if (modCatInstalled(i)) {
+			snprintf(s_CatNote, sizeof(s_CatNote), "%s is installed.\nPlay it from Perfect Dark Mods.\n", s_Cat[i].name);
+		} else {
+			modCatStart(i);
+		}
+		break;
+	}
+
+	return 0;
+}
+
+static char *menutextModCatNote(struct menuitem *item)
+{
+	modCatTick();
+
+	if (modCatBusy() && s_CatJob >= 0) {
+		const u32 done = (u32)s_CatBuf.len;
+
+		snprintf(s_CatNote, sizeof(s_CatNote), "Downloading %s\n%u.%u MB (Back stops it)\n",
+				s_Cat[s_CatJob].name, done / 1048576, (done % 1048576) * 10 / 1048576);
+	} else if (modCatBusy()) {
+		return "Looking for mods...\n";
+	} else if (s_CatCount <= 0) {
+		return "No mod list. Mods go in the mods folder.\n";
+	} else if (!s_CatNote[0]) {
+		return "Choose a mod to download it.\n";
+	}
+
+	return s_CatNote;
+}
+
+static MenuDialogHandlerResult menudialogModCat(s32 operation, struct menudialogdef *dialogdef, union handlerdata *data)
+{
+	if (operation == MENUOP_OPEN && !modCatBusy()) {
+		// fsFileLoad ends what it reads with a '\0'
+		char *text = fsFileSize("$E/" MODCAT_FILE) > 0 ? fsFileLoad("$E/" MODCAT_FILE, NULL) : NULL;
+
+		if (text) {
+			s_CatCount = modCatParse(text, s_Cat);
+			sysMemFree(text);
+		} else if (s_CatCount < 0) {
+			s_CatCount = 0;
+		}
+
+		s_CatNote[0] = '\0';
+		modCatStart(-1); // the newer list, when there is one
+	} else if (operation == MENUOP_CLOSE && modCatBusy()) {
+		s_CatCancel = 1;
+	}
+
+	return false;
+}
+
+static struct menuitem g_ModCatMenuItems[] = {
+	{
+		MENUITEMTYPE_LABEL,
