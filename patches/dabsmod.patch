+/*
+ * Bot backfill (Net.BotBackfill, off unless turned on): at each launch of a
+ * Combat Simulator room, simulants for the seats no player took - the room's
+ * size less the players who connected, up to the cartridge's eight
+ * simulants in all - beside the host's own. Each launch first takes the last
+ * one's back out, so a player who joins the room between matches has their
+ * seat back from a bot at the next one. Someone joining a match in progress
+ * plays beside the bots until it ends.
+ */
+s32 g_NetBotBackfill = 0;
+static u8 s_Backfilled[MAX_BOTS];
+
+static void lobbyBackfill(s32 humans)
+{
+	s32 want, added = 0;
+
+	for (s32 i = 0; i < MAX_BOTS; i++) {
+		if (s_Backfilled[i]) {
+			s_Backfilled[i] = 0;
+
+			if (mpIsSimSlotOn(i)) {
+				mpRemoveSimulant(i);
+			}
+		}
+	}
+
+	if (!g_NetBotBackfill || g_NetCoopSetup.on) {
+		return;
+	}
+
+	want = s_Room.sum.maxhumans - humans;
+
+	if (want > MAX_BOTS_CONFIG - mpGetNumSimSlotsOn()) {
+		want = MAX_BOTS_CONFIG - mpGetNumSimSlotsOn();
+	}
+
+	for (s32 i = 0; i < MAX_BOTS && added < want; i++) {
+		if (!mpIsSimSlotOn(i)) {
+			mpCreateBotFromProfile(i, 2); // NormalSim
+			s_Backfilled[i] = 1;
+			added++;
+		}
+	}
+
+	if (added > 0) {
+		mpGenerateBotNames();
+	}
+
+	sysLogPrintf(LOG_NOTE, "lobby: bot backfill: %d player%s in a room for %d, %d simulant%s added", humans,
+			humans == 1 ? "" : "s", s_Room.sum.maxhumans, added, added == 1 ? "" : "s");
+}
