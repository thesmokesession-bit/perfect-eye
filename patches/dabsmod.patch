+static void inputPs5UpdateTriggers(void)
+{
+	static Ps5Trig sent[4][2];
+	static s32 sentto[4] = { -1, -1, -1, -1 };
+	struct player *forpad[4] = { NULL };
+
+	if (g_NetMode != NETMODE_NONE) {
+		forpad[0] = netLocalPlayer(NULL);
+	} else {
+		for (s32 p = 0; p < MAX_PLAYERS; p++) {
+			if (g_Vars.players[p]) {
+				const s32 pad = optionsGetContpadNum1(g_Vars.playerstats[p].mpindex);
