diff --git a/port/src/modmode.c b/port/src/modmode.c
index 88752f3bc..7f69fc4be 100644
--- a/port/src/modmode.c
+++ b/port/src/modmode.c
@@ -57,6 +57,10 @@
 #include "mpsetups.h"
 #include "constants.h"
 #include "bss.h"
+#include <stdlib.h>
+#include <SDL.h>
