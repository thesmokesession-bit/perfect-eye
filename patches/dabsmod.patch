+
+		for (s32 t = 0; t < 2; t++) {
+			fx.command[t].mode = want[t].mode;
+			fx.command[t].data[0] = want[t].a;
+			fx.command[t].data[1] = want[t].b;
+			fx.command[t].data[2] = want[t].c;
+		}
+
+		scePadSetTriggerEffect(gyroHandle[i], &fx);
