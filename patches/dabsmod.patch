+// Join by Code: a room's id, which the room shows as its code
+static MenuItemHandlerResult handlerJoinCode(s32 operation, struct menuitem *item, union handlerdata *data)
+{
+	char id[9];
+	s32 len = 0;
+
+	switch (operation) {
+	case MENUOP_GETTEXT:
+		snprintf(data->keyboard.string, MPSETUP_MAXNAME + 1, "%s", s_JoinCode);
+		break;
+	case MENUOP_SETTEXT:
+		snprintf(s_JoinCode, sizeof(s_JoinCode), "%s", data->keyboard.string);
+		break;
+	case MENUOP_SET:
+		// eight hex digits whatever the case, spaces dropped
+		for (const char *c = s_JoinCode; *c && len < 9; c++) {
+			if (isxdigit((u8)*c)) {
+				id[len++] = tolower((u8)*c);
+			} else if (*c != ' ' && *c != '-') {
+				len = 9;
+			}
+		}
+
+		if (len != 8) {
+			netLobbySetMessage("A room code is eight letters and numbers.");
+			menuPlaySound(MENUSOUND_ERROR);
+			break;
+		}
+
+		id[8] = '\0';
+		snprintf(s_JoinId, sizeof(s_JoinId), "%s", id);
+
+		for (s32 i = 0; i < netLobbyNumRooms(); i++) {
+			const struct netlobbyroomsum *r = netLobbyRoomAt(i);
+
+			if (r && r->locked && !strcmp(r->id, id)) {
+				menuPushDialog(&g_NetJoinPasswordMenuDialog);
+				return 0;
+			}
+		}
+
+		s_WaitingForRoom = 1;
+		netLobbyJoin(id, "");
+		break;
+	}
+
+	return 0;
+}
